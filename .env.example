PORT=3000

# Banco de dados
DB_HOST=localhost
DB_PORT=3306
DB_USER=SEU_USUARIO_DB
DB_PASS=SUA_SENHA_DB
DB_NAME=SEU_BANCO_DB

# Segurança — gere um valor único e forte (ex: openssl rand -base64 48)
JWT_SECRET=GERE_UM_VALOR_SECRETO_FORTE_AQUI

# Resend — envio de e-mails transacionais (reset de senha, reset de PIN)
RESEND_API_KEY=SEU_TOKEN_RESEND_AQUI
EMAIL_FROM=nao-responda@panificapro.com.br

# Token de segurança do webhook Hotmart (configurar em: Hotmart > Ferramentas > Webhooks > Hottok)
HOTMART_HOTTOK=SEU_TOKEN_HOTMART_AQUI

# URL pública da aplicação
APP_URL=https://app.panificapro.com.br

# Origens permitidas pelo CORS (separadas por vírgula)
ALLOWED_ORIGINS=https://app.panificapro.com.br

# Conta admin criada/usada no primeiro boot (ver src/index.js)
ADMIN_EMAIL=admin@panificapro.com.br
ADMIN_SENHA=DEFINA_UMA_SENHA_FORTE_AQUI

# PIN mestre de suporte para destravar o módulo Financeiro sem saber o PIN do cliente
PIN_FINANCEIRO_MASTER=DEFINA_UM_PIN_AQUI
